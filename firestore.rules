rules_version = '2';

// Regole Firestore di Registro Chiamate (da copiare in Console Firebase -> Firestore
// Database -> Regole -> Pubblica). Questo file è solo documentazione: Firebase non lo
// legge da qui.
//
// Versione definitiva multi-utente (pubblicata dopo la copia dell'archivio
// mono-utente, 2026-10-01): ogni account accede solo al proprio archivio. Le vecchie
// collection "contacts" e "calls" alla radice non sono più accessibili dall'app
// (restano leggibili solo dalla function calendar tramite Admin SDK e dalla console).

service cloud.firestore {
  match /databases/{database}/documents {

    // users/<uid> (token calendario) e users/<uid>/contacts, users/<uid>/calls.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
