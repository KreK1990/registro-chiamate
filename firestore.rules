rules_version = '2';

// Regole Firestore di Registro Chiamate (da copiare in Console Firebase -> Firestore
// Database -> Regole -> Pubblica). Questo file è solo documentazione: Firebase non lo
// legge da qui.
//
// FASE 1 (transizione): archivi personali + vecchio archivio condiviso ancora
// leggibile, per poterlo copiare nel proprio archivio dall'app.
// FASE 2 (definitiva): eliminare il blocco "archivio precedente" qui sotto, PRIMA di
// creare gli account dei colleghi.

service cloud.firestore {
  match /databases/{database}/documents {

    // Ogni utente legge e scrive solo il proprio archivio:
    // users/<uid> (token calendario) e users/<uid>/contacts, users/<uid>/calls.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // --- Archivio precedente (versione mono-utente) - da togliere in FASE 2 ---
    match /contacts/{docId} {
      allow read, write: if request.auth != null;
    }
    match /calls/{docId} {
      allow read, write: if request.auth != null;
    }
    // --- fine archivio precedente ---
  }
}
